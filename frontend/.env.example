# Backend API base URL
VITE_API_URL=http://localhost:4000
# Public URL of this frontend, used for share links and metadata
VITE_SITE_URL=http://localhost:3000
# Show "Continue as guest" on the sign-in page. Unset: shown in development only.
VITE_ENABLE_GUEST_LOGIN=
# Show "Continue with ChatGPT". Leave empty until OpenAI gives you a client (partner-only beta).
VITE_ENABLE_CHATGPT_LOGIN=
