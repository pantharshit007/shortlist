NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/resumebuilder
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info
FRONTEND_URL=http://localhost:3000

# AI: pick openai, anthropic or openrouter and set that provider's key.
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Optional model overrides; defaults depend on the provider.
AI_MODEL_FAST=
AI_MODEL_SMART=

# Email via Resend. Without a key, development prints emails to the log.
RESEND_API_KEY=
EMAIL_FROM=Resume Builder <onboarding@resend.dev>
