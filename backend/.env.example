NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/resumebuilder
# Rate limit counters; required in production
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info
FRONTEND_URL=http://localhost:3000

# AI: pick openai, anthropic or openrouter and set that provider's key.
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Optional model overrides; defaults depend on the provider.
AI_MODEL_FAST=
AI_MODEL_SMART=

# Auth (Better Auth). Generate the secret with: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000
# Production only, e.g. .yourdomain.com, so app. and api. share the session cookie.
COOKIE_DOMAIN=
# One-click guest accounts (deleted after 7 days). Unset: on in development, off in production.
ENABLE_GUEST_LOGIN=
# Sign-in providers. Google, GitHub and ChatGPT are the only ways to sign in.
# Callback URLs: <BETTER_AUTH_URL>/api/auth/callback/google, /api/auth/callback/github
# and /api/auth/oauth2/callback/chatgpt
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# "Sign in with ChatGPT" (beta). Register the app in the OpenAI platform console.
# Leave the discovery URL empty unless the console shows a different issuer.
CHATGPT_CLIENT_ID=
CHATGPT_CLIENT_SECRET=
CHATGPT_DISCOVERY_URL=

# File storage for PDFs, uploads and backups. "local" writes to LOCAL_STORAGE_DIR.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
# Cloudflare R2 (S3-compatible), used when STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# LaTeX compiler (Tectonic). In production set COMPILER_URL to the separate compiler
# service (e.g. http://compiler:4100). Unset in development compiles in-process.
COMPILER_URL=
TECTONIC_BIN=tectonic
TECTONIC_ONLY_CACHED=false
COMPILE_TIMEOUT_MS=20000
COMPILE_CONCURRENCY=2

# Job post fetching from URLs via Jina Reader (works without a key at a lower rate limit)
JINA_API_KEY=

# Payments (Razorpay). Webhook URL: <BETTER_AUTH_URL>/v1/webhooks/razorpay
# Events: payment.captured, payment.failed, refund.processed, subscription.activated,
# subscription.charged, subscription.cancelled, subscription.completed, subscription.halted
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PRO_PLAN_ID=

# Production only (docker-compose.prod.yml reads these from .env.production)
API_DOMAIN=api.example.com
POSTGRES_PASSWORD=
# Encrypts nightly database backups. Generate with: openssl rand -hex 32. Store a copy outside the server.
BACKUP_ENCRYPTION_KEY=
