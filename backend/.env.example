NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/resumebuilder
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info
FRONTEND_URL=http://localhost:3000

# AI: pick openai, anthropic or openrouter and set that provider's key.
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Optional model overrides; defaults depend on the provider.
AI_MODEL_FAST=
AI_MODEL_SMART=

# Email via Resend. Without a key, development prints emails to the log.
RESEND_API_KEY=
EMAIL_FROM=Resume Builder <onboarding@resend.dev>

# Auth (Better Auth). Generate the secret with: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000
# Production only, e.g. .yourdomain.com, so app. and api. share the session cookie.
COOKIE_DOMAIN=
# OAuth apps. Callback URLs: <BETTER_AUTH_URL>/api/auth/callback/google and /callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# File storage for PDFs, uploads and backups. "local" writes to LOCAL_STORAGE_DIR.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
# Cloudflare R2 (S3-compatible), used when STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
